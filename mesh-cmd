#!/usr/bin/env python3
"""mesh-cmd - send a ChirpStack Gateway Mesh proprietary command to a relay.

Two transports, same commands:
  default   MQTT to the Border's broker -- run from anywhere, stdlib only.
  --local   ZMQ straight to gateway-mesh -- run ON the Border, no broker,
            no credentials, and works whatever the LNS egress is (needs pyzmq).

Pure Python standard library (socket + ssl only) -- no pip installs. Runs from
any machine that can reach the MQTT broker the Border Gateway is connected to.

It encodes a gw.MeshCommand protobuf and publishes it to
  <prefix>/gateway/<border_eui>/command/mesh
then prints the relay's ack (a gw.MeshEvent on <prefix>/gateway/<border_eui>/event/mesh).

Config resolution (highest priority first): CLI flags > env vars > --config file.
On a Border Gateway itself, --from-gateway reads broker+creds+prefix from
/run/relay/mqtt-config.toml (older images: /data/config/relay).

Examples:
  mesh-cmd --config ~/.mesh-cmd.conf reboot 11223344
  mesh-cmd --broker ssl://lns.example.net:8883 --user op --pass s3cret \\
           --border-eui 0016c001aabbccdd --prefix eu868 reboot 11223344
  mesh-cmd --config ~/.mesh-cmd.conf send 11223344 199 48656c6c6f   # type 199, payload "Hello"

NOTE: the Border's mqtt-forwarder must be in protobuf mode (mqtt.json=false, the
default) -- this tool publishes protobuf.
"""
import argparse
import configparser
import os
import re
import socket
import ssl
import json
import struct
import sys
import time

# Built-in fallback catalog, used only if mesh-commands.json cannot be found.
# The bundled mesh-commands.json is the real source of truth (see load_catalog).
BUILTIN_CATALOG = [
    {"type": 128, "name": "reboot",
     "description": "Reboot the relay (re-opens the boot-time WiFi access window).",
     "params": []},
]

def load_catalog(explicit=None):
    """Load the command catalog (list of {type,name,description,params}).
    Search order: --catalog/arg > $MESHCMD_CATALOG > mesh-commands.json next to
    this script > ./mesh-commands.json. Falls back to BUILTIN_CATALOG.

    realpath, not abspath: SenOS installs the script under /opt and puts a
    symlink in ${bindir} so senarch-help lists it. abspath would resolve to
    /usr/bin, miss the bundled catalog, and silently degrade to the one-entry
    fallback -- leaving 11 of 12 commands unreachable via the documented name."""
    candidates = [
        explicit,
        os.environ.get("MESHCMD_CATALOG"),
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "mesh-commands.json"),
        "mesh-commands.json",
    ]
    for path in candidates:
        if path and os.path.isfile(path):
            with open(path) as f:
                data = json.load(f)
            cmds = data.get("commands", data) if isinstance(data, dict) else data
            return [c for c in cmds if isinstance(c, dict) and "type" in c and "name" in c]
    # The fallback carries one command. Falling back is always a deployment
    # fault, and a silent one reads as "the relay lacks that command" -- so say
    # so on stderr, where it will not corrupt list-commands' stdout.
    sys.stderr.write(
        "warning: no mesh-commands.json found (looked next to %s and in .); "
        "using the built-in %d-command fallback\n" % (os.path.realpath(__file__), len(BUILTIN_CATALOG)))
    return BUILTIN_CATALOG

# ---------------- protobuf: encode gw.MeshCommand ----------------
def _uv(n):
    o = bytearray()
    while True:
        b = n & 0x7F; n >>= 7
        o.append(b | 0x80 if n else b)
        if not n:
            return bytes(o)
def _ld(field, data): return _uv((field << 3) | 2) + _uv(len(data)) + data
def _vi(field, n):    return _uv((field << 3) | 0) + _uv(n)

def build_mesh_command(border_eui, relay_id, cmd_type, payload=b""):
    prop = _vi(1, cmd_type) + (_ld(2, payload) if payload else b"")   # MeshCommandProprietary
    item = _ld(1, prop)                                               # MeshCommandItem.proprietary
    return _ld(1, border_eui.encode()) + _ld(2, relay_id.encode()) + _ld(3, item)

# ---------------- protobuf: decode gw.MeshEvent (ack) ----------------
def _rv(b, i):
    r = s = 0
    while True:
        x = b[i]; i += 1; r |= (x & 0x7F) << s
        if not x & 0x80:
            return r, i
        s += 7
def _fields(b):
    i = 0; out = []
    while i < len(b):
        key, i = _rv(b, i); f, wt = key >> 3, key & 7
        if wt == 0: v, i = _rv(b, i); out.append((f, 0, v))
        elif wt == 2: l, i = _rv(b, i); out.append((f, 2, b[i:i+l])); i += l
        elif wt == 5: out.append((f, 5, b[i:i+4])); i += 4
        elif wt == 1: out.append((f, 1, b[i:i+8])); i += 8
        else: break
    return out
def decode_mesh_event(b):
    relay_id = None; evs = []
    for f, wt, v in _fields(b):
        if f == 2 and wt == 2: relay_id = v.decode(errors="replace")
        if f == 4 and wt == 2:                       # MeshEventItem
            for f2, wt2, v2 in _fields(v):
                if f2 == 1 and wt2 == 2:             # proprietary
                    et, pl = None, b""
                    for f3, wt3, v3 in _fields(v2):
                        if f3 == 1 and wt3 == 0: et = v3
                        if f3 == 2 and wt3 == 2: pl = v3
                    evs.append(("proprietary", et, pl))
                elif f2 == 2 and wt2 == 2:
                    evs.append(("heartbeat", None, b""))
    return relay_id, evs

# ---------------- minimal MQTT 3.1.1 ----------------
def _s(x): b = x.encode(); return struct.pack("!H", len(b)) + b
def _rl(n):
    o = bytearray()
    while True:
        d = n % 128; n //= 128
        o.append(d | 0x80 if n else d)
        if not n:
            return bytes(o)
def _read_rl(sock):
    n = s = 0
    while True:
        c = sock.recv(1)[0]; n |= (c & 0x7F) << s
        if not c & 0x80:
            return n
        s += 7
def _read_pkt(sock):
    h = sock.recv(1)
    if not h:
        return None, None
    ln = _read_rl(sock); buf = b""
    while len(buf) < ln:
        buf += sock.recv(ln - len(buf))
    return h[0], buf

def _mqtt_connect_subscribe(broker, user, pw, sub_topic):
    """Open an MQTT 3.1.1 connection to `broker` and subscribe to `sub_topic`.
    Returns the connected socket. Exits on a bad broker URL or CONNECT reject."""
    m = re.match(r'(tcp|ssl)://([^:/]+)(?::(\d+))?', broker)
    if not m:
        sys.exit("error: broker must be tcp://host[:port] or ssl://host[:port], got %r" % broker)
    scheme, host = m.group(1), m.group(2)
    port = int(m.group(3)) if m.group(3) else (8883 if scheme == "ssl" else 1883)
    print("broker=%s://%s:%d user=%r" % (scheme, host, port, user))

    raw = socket.create_connection((host, port), timeout=15)
    sock = ssl.create_default_context().wrap_socket(raw, server_hostname=host) if scheme == "ssl" else raw

    vh = _s("MQTT") + bytes([4, 0xC2]) + struct.pack("!H", 30)   # clean + user + pass
    # unique client id per process so a listener + a command can run at once
    # without the broker booting one for a duplicate client id.
    body = vh + _s("mesh-cmd-%d" % os.getpid()) + _s(user or "") + _s(pw or "")
    sock.sendall(bytes([0x10]) + _rl(len(body)) + body)
    t, b = _read_pkt(sock)
    if t != 0x20 or not b or b[1] != 0:
        sys.exit("MQTT CONNECT rejected (type=%s rc=%s) -- check broker/credentials" %
                 (hex(t) if t else "?", b[1] if b else "?"))
    print("connected.")

    sub = struct.pack("!H", 1) + _s(sub_topic) + bytes([0])
    sock.sendall(bytes([0x82]) + _rl(len(sub)) + sub)
    _read_pkt(sock)  # SUBACK
    return sock

def publish_and_wait(broker, user, pw, cmd_topic, evt_topic, payload, wait, show=True, expect_rid=None):
    sock = _mqtt_connect_subscribe(broker, user, pw, evt_topic)
    print("pub -> %s\nsub <- %s" % (cmd_topic, evt_topic))

    pub = _s(cmd_topic) + payload
    sock.sendall(bytes([0x30]) + _rl(len(pub)) + pub)
    print("published (%d bytes), waiting up to %ds for the ack..." % (len(payload), wait))

    events = []   # collected proprietary acks: list of (event_type, payload_bytes)
    sock.settimeout(wait); deadline = time.time() + wait
    while time.time() < deadline:
        try:
            t, b = _read_pkt(sock)
        except (socket.timeout, ssl.SSLWantReadError):
            break
        if t is None:
            break
        if (t & 0xF0) == 0x30:
            tlen = struct.unpack("!H", b[:2])[0]
            msg = b[2+tlen:]
            rid, evs = decode_mesh_event(msg)
            if expect_rid and rid != expect_rid:
                continue   # ack for a different relay on the shared event topic
            for kind, et, pl in evs:
                if kind == "proprietary":
                    events.append((et, pl))
                    if show:
                        print("\nACK  relay_id=%s  event_type=%s\n     payload=%r" %
                              (rid, et, pl.decode(errors="replace")))
        if events:
            break      # got our relay's ack -- no need to wait out the timeout
    try:
        sock.sendall(bytes([0xE0, 0x00]))
    except OSError:
        pass
    if show:
        print("\n=> " + ("ack received, command executed." if events
                         else "no ack within %ds (relay may be out of range / rebooting; check its journal)" % wait))
    return (0 if events else 2), events

def listen_for_relays(broker, user, pw, evt_topic, duration):
    """Passively listen on the border's mesh event topic and collect the
    relay_ids heard. Relays announce themselves via periodic heartbeats;
    relayed uplinks also carry the originating relay_id. No command is sent.
    Returns {relay_id: {"count", "last", "via"}}."""
    print("listening on %s for %ds..." % (evt_topic, duration))
    sock = _mqtt_connect_subscribe(broker, user, pw, evt_topic)
    print("(relays announce on their heartbeat interval -- SenOS default 5m; ctrl-c to stop early)")

    seen = {}
    deadline = time.time() + duration
    last_ping = time.time()
    while time.time() < deadline:
        sock.settimeout(min(5.0, max(0.1, deadline - time.time())))
        try:
            t, b = _read_pkt(sock)
        except (socket.timeout, ssl.SSLWantReadError):
            t, b = -1, None            # idle slice; fall through to keepalive
        except OSError:
            break
        except KeyboardInterrupt:
            print("  (stopped)")
            break
        if t is None:                  # broker closed the connection
            break
        if t != -1 and (t & 0xF0) == 0x30:   # PUBLISH
            tlen = struct.unpack("!H", b[:2])[0]
            rid, evs = decode_mesh_event(b[2+tlen:])
            if rid:
                rec = seen.setdefault(rid, {"count": 0, "last": 0.0, "via": set()})
                rec["count"] += 1
                rec["last"] = time.time()
                for kind, _et, _pl in evs:
                    rec["via"].add(kind)
                if rec["count"] == 1:
                    print("  + %s" % rid)
        if time.time() - last_ping > 20:
            try:
                sock.sendall(bytes([0xC0, 0x00]))  # PINGREQ (stay under keepalive)
            except OSError:
                break
            last_ping = time.time()

    try:
        sock.sendall(bytes([0xE0, 0x00]))          # DISCONNECT
    except OSError:
        pass
    return seen

# ---------------- local transport: ZMQ to gateway-mesh ----------------
# On the Border itself no broker is needed. MQTT is only how the request reaches
# the gateway: chirpstack-mqtt-forwarder decodes the payload and hands it to
# chirpstack-gateway-mesh's proxy API as gw.Command{mesh=5} over ZMQ. --local
# talks to that socket directly, so relay management keeps working on a border
# that forwards to a non-ChirpStack LNS over Semtech UDP and runs no MQTT
# forwarder at all (Senarch/gateway-with-yocto#424).
#
# --from-gateway also runs on the Border, but still goes out to the broker and
# back, so it needs mqtt-forwarder running. --local does not.

LOCAL_COMMAND_URL = os.environ.get("MESHCMD_COMMAND_URL", "ipc:///tmp/gateway_relay_command")
LOCAL_EVENT_URL = os.environ.get("MESHCMD_EVENT_URL", "ipc:///tmp/gateway_relay_event")

_zmq = None
def _load_zmq():
    """Imported lazily so the tool stays stdlib-only for remote (MQTT) use."""
    global _zmq
    if _zmq is None:
        try:
            import zmq
        except ImportError:
            sys.exit("error: --local needs pyzmq (SenOS: it ships with the senarch-mesh-cmd package;\n"
                     "       elsewhere: pip install pyzmq). Remote MQTT mode needs no extra packages.")
        _zmq = zmq
    return _zmq

def _wrap_command(field, body):
    """gw.Command oneof: send_downlink_frame=1, set_gateway_configuration=2,
    get_gateway_id=3, get_location=4, mesh=5."""
    return _ld(field, body)

def decode_event_mesh(b):
    """gw.Event{mesh=3} -> (relay_id, events). The ZMQ event socket carries the
    Event wrapper; the MQTT event topic carries a bare MeshEvent."""
    for f, wt, v in _fields(b):
        if f == 3 and wt == 2:
            return decode_mesh_event(v)
    return None, []

def _zmq_req(payload, timeout_ms=5000):
    """One REQ/REP round trip on a fresh socket. A REQ that never read its reply
    is stuck in EFSM for any later send, so the socket is not reused."""
    zmq = _load_zmq()
    sock = zmq.Context.instance().socket(zmq.REQ)
    sock.setsockopt(zmq.LINGER, 0)
    sock.setsockopt(zmq.RCVTIMEO, timeout_ms)
    sock.setsockopt(zmq.SNDTIMEO, timeout_ms)
    sock.connect(LOCAL_COMMAND_URL)
    try:
        sock.send(payload)
        return sock.recv()
    except zmq.Again:
        sys.exit("error: no reply from gateway-mesh on %s\n"
                 "       run this on a Border gateway with gateway-relay.service active"
                 % LOCAL_COMMAND_URL)
    finally:
        sock.close()

def local_border_eui():
    """Ask gateway-mesh for the border's own EUI, so --local needs no config."""
    for f, wt, v in _fields(_zmq_req(_wrap_command(3, b""))):
        if f == 1 and wt == 2:
            return v.decode(errors="replace")
    return None

def _local_sub():
    zmq = _load_zmq()
    sock = zmq.Context.instance().socket(zmq.SUB)
    sock.setsockopt(zmq.LINGER, 0)
    sock.setsockopt_string(zmq.SUBSCRIBE, "")
    sock.connect(LOCAL_EVENT_URL)
    return sock

def local_send_and_wait(payload, wait, show=True, expect_rid=None):
    """--local equivalent of publish_and_wait(). Same (rc, events) contract."""
    sub = _local_sub()
    print("cmd -> %s\nevt <- %s" % (LOCAL_COMMAND_URL, LOCAL_EVENT_URL))

    # Subscribe before sending: a fast relay could otherwise ack before we are
    # listening. The REQ reply is an empty frame -- it only means the border
    # accepted the command for relaying; the real ack arrives over LoRa.
    _zmq_req(_wrap_command(5, payload))
    print("sent (%d bytes), waiting up to %ds for the ack..." % (len(payload), wait))

    events = []
    deadline = time.time() + wait
    while time.time() < deadline:
        remaining = max(0, int((deadline - time.time()) * 1000))
        if not sub.poll(remaining):
            break
        rid, evs = decode_event_mesh(sub.recv())
        if expect_rid and rid and rid.lower() != expect_rid.lower():
            continue
        for kind, et, pl in evs:
            if kind == "proprietary":
                events.append((et, pl))
                if show:
                    print("\nACK  relay_id=%s  event_type=%s\n     payload=%r" %
                          (rid, et, pl.decode(errors="replace")))
        if events:
            break
    sub.close()
    if show:
        print("\n=> " + ("ack received, command executed." if events
                         else "no ack within %ds (relay may be out of range / rebooting; check its journal)" % wait))
    return (0 if events else 2), events

def local_listen_for_relays(duration):
    """--local equivalent of listen_for_relays()."""
    print("listening on %s for %ds..." % (LOCAL_EVENT_URL, duration))
    print("(relays announce on their heartbeat interval -- SenOS default 5m; ctrl-c to stop early)")
    sub = _local_sub()
    seen = {}
    deadline = time.time() + duration
    try:
        while time.time() < deadline:
            remaining = max(0, int((deadline - time.time()) * 1000))
            if not sub.poll(remaining):
                continue
            rid, evs = decode_event_mesh(sub.recv())
            if not rid:
                continue
            rec = seen.setdefault(rid, {"count": 0, "last": 0.0, "via": set()})
            rec["count"] += 1
            rec["last"] = time.time()
            for kind, _et, _pl in evs:
                rec["via"].add(kind)
            if rec["count"] == 1:
                print("  + %s" % rid)
    except KeyboardInterrupt:
        print("  (stopped)")
    sub.close()
    return seen

# ---------------- config resolution ----------------
def default_config_path():
    """First existing mesh-cmd.conf, so `--config` is optional: $MESHCMD_CONFIG,
    then the current directory, then next to this script, then the user config
    dir. Returns None if none exist.

    realpath for the same reason as load_catalog: invoked through the ${bindir}
    symlink, abspath points at /usr/bin, so a mesh-cmd.conf placed beside the
    script is silently ignored."""
    home = os.path.expanduser("~")
    for p in (os.environ.get("MESHCMD_CONFIG"),
              "mesh-cmd.conf",
              os.path.join(os.path.dirname(os.path.realpath(__file__)), "mesh-cmd.conf"),
              os.path.join(home, ".config", "mesh-cmd", "mesh-cmd.conf"),
              os.path.join(home, ".mesh-cmd.conf")):
        if p and os.path.isfile(p):
            return p
    return None

def load_config(args):
    cfg = {"broker": None, "user": None, "pass": None, "border_eui": None, "prefix": None}
    # 3) config file: explicit --config, else the first mesh-cmd.conf discovered
    cfg_path = args.config or default_config_path()
    if cfg_path:
        cp = configparser.ConfigParser()
        if not cp.read(os.path.expanduser(cfg_path)):
            sys.exit("error: cannot read config %s" % cfg_path)
        b = cp["broker"] if cp.has_section("broker") else {}
        g = cp["gateway"] if cp.has_section("gateway") else {}
        cfg.update(broker=b.get("url"), user=b.get("username"), **{"pass": b.get("password")})
        cfg.update(border_eui=g.get("border_eui"), prefix=g.get("prefix"))
    # 2) env vars override the file
    for k, e in (("broker", "MESHCMD_BROKER"), ("user", "MESHCMD_USER"), ("pass", "MESHCMD_PASS"),
                 ("border_eui", "MESHCMD_BORDER_EUI"), ("prefix", "MESHCMD_PREFIX")):
        if os.environ.get(e):
            cfg[k] = os.environ[e]
    # 1) explicit CLI flags win
    for k, a in (("broker", args.broker), ("user", args.user), ("pass", args.password),
                 ("border_eui", args.border_eui), ("prefix", args.prefix)):
        if a:
            cfg[k] = a
    # 0) --from-gateway: read the border's own rendered mqtt-config.toml. SenOS
    # 2.1.0+ renders it to /run/relay; older images used /data/config/relay.
    if args.from_gateway:
        txt = None
        for _p in ("/run/relay/mqtt-config.toml", "/data/config/relay/mqtt-config.toml"):
            try:
                txt = open(_p).read(); break
            except OSError:
                continue
        if txt is None:
            sys.exit("error: --from-gateway: no mqtt-config.toml in /run/relay or "
                     "/data/config/relay (run this on a Border gateway)")
        def g(key):
            mm = re.search(r'(?m)^\s*%s\s*=\s*"?([^"\n]*)"?' % key, txt)
            return mm.group(1) if mm else None
        cfg["broker"] = cfg["broker"] or g("server")
        cfg["user"] = cfg["user"] or g("username")
        cfg["pass"] = cfg["pass"] or g("password")
        cfg["prefix"] = cfg["prefix"] or g("topic_prefix")
        # The EUI is not in mqtt-config.toml -- mqtt-forwarder asks concentratord
        # for it at runtime -- but it is rendered next door, so read it there.
        # Without this --from-gateway supplies everything EXCEPT border_eui and
        # then fails asking for the one thing it was meant to provide.
        #
        # From /run rather than relay.json deliberately: --from-gateway means
        # "what this gateway is currently running", and /run is what the daemons
        # loaded. relay.json is what is *configured*, which differs whenever it
        # has been edited without restarting the stack -- pairing a running
        # broker with a pending EUI is the worst of both.
        if not cfg["border_eui"]:
            for _p in ("/run/relay/concentratord-config.toml",
                       "/data/config/relay/concentratord-config.toml"):
                try:
                    m = re.search(r'(?m)^\s*gateway_id\s*=\s*"([0-9a-fA-F]{16})"', open(_p).read())
                except OSError:
                    continue
                if m:
                    cfg["border_eui"] = m.group(1)
                    break
    return cfg

PROG = "mesh-cmd"

def print_usage(file=None):
    (file or sys.stdout).write("""mesh-cmd - send ChirpStack Gateway Mesh commands to a relay

Transports: MQTT to the Border's broker (default), or --local to talk to
gateway-mesh directly over ZMQ when running on the Border itself.

Usage:
  mesh-cmd [connection options] <command> [arguments]

Commands:
  reboot <relay_id>              Reboot the relay (re-opens the boot-time WiFi window)
  ping <relay_id>                Connectivity check -- the relay replies "pong"
  set-hop-count <relay_id> <n>   Set the mesh max hop count (1-8) and persist it
  open-wifi <relay_id> [min]     Open the relay's WiFi window for N minutes (default 30)
  close-wifi <relay_id>          Force the relay's WiFi off now
  gps-fix <relay_id> [min]       Acquire a GPS fix (default 70, max 90) and persist the location
  gps-status <relay_id>          Report GPS acquisition status + the persisted location
  run <name> <relay_id> [hex]    Run a named catalog command (status, power, version, restart-stack)
  discover <relay_id>            Ask a relay which command types it has configured
  relays                         List relay_ids the Border is hearing (passive; no relay_id needed)
  send <relay_id> <type> [hex]   Send a raw proprietary command (128-255) + optional hex payload
  list-commands                  Print this tool's local command catalog

Connection options (or set them in the --config file / environment):
  --config <path>       INI file (optional -- auto-detected; see Config below)
  --broker <url>        ssl://host:port or tcp://host:port
  --user <name>         MQTT username
  --password <pass>     MQTT password
  --border-eui <eui>    Border Gateway EUI (16 hex chars)
  --prefix <id>         MQTT topic prefix / LNS region id (e.g. eu868)
  --local               On the Border: talk to gateway-mesh directly over ZMQ (no broker,
                        no credentials, works with any LNS egress -- needs pyzmq)
  --from-gateway        On the Border: read broker, credentials, topic prefix and
                        the gateway EUI from the rendered configs in /run/relay
  --timeout <seconds>   Seconds to wait for a command ack (default 25)
  --catalog <path>      Use a specific mesh-commands.json

Examples (with a mesh-cmd.conf in the current directory):
  mesh-cmd relays                     # list relay_ids the Border is hearing
  mesh-cmd discover 11223344          # which commands does this relay support?
  mesh-cmd reboot 11223344            # reboot it
  mesh-cmd ping 11223344              # reachable over the mesh? (-> pong)
  mesh-cmd run power 11223344         # a catalog command by name (status/power/version)
  mesh-cmd set-hop-count 11223344 3   # set the mesh max hop count
  mesh-cmd open-wifi 11223344 30      # open WiFi 30 min (close-wifi to force off)
  mesh-cmd gps-fix 11223344           # acquire a GPS fix (default 70 min); poll with gps-status
  mesh-cmd gps-status 11223344        # GPS progress + the persisted location

  # 'send' fires a RAW proprietary type (128-255) with an optional hex-bytes
  # payload piped to the relay script's stdin; an ASCII number is hex-encoded
  # ("3" = 33, "30" = 3330). Each of these equals a named command above:
  mesh-cmd send 11223344 254          # == ping            (no payload)
  mesh-cmd send 11223344 150 33       # == set-hop-count 3  (payload "3")
  mesh-cmd send 11223344 129 3330     # == open-wifi 30     (payload "30")

  # connection settings can be given as flags instead of the config file:
  mesh-cmd --broker ssl://lns.example.net:8883 --user op --pass s3cret \\
           --border-eui 0016c001aabbccdd --prefix eu868 ping 11223344

Config: a mesh-cmd.conf in the current dir (or next to this script, or
~/.config/mesh-cmd/mesh-cmd.conf) is auto-loaded, so --config is optional.
Resolution (highest first): CLI flags > environment variables > config file.

Environment overrides:
  MESHCMD_BROKER
  MESHCMD_USER
  MESHCMD_PASS
  MESHCMD_BORDER_EUI
  MESHCMD_PREFIX
  MESHCMD_CATALOG
""")

class UsageParser(argparse.ArgumentParser):
    # Any bad usage prints our block (like the Go CLI's printUsage), not argparse's.
    def error(self, message):
        print_usage(sys.stderr)
        sys.stderr.write("\nerror: %s\n" % message)
        sys.exit(2)

def main():
    if len(sys.argv) == 1 or sys.argv[1] == "help" or any(a in ("-h", "--help") for a in sys.argv[1:]):
        print_usage()
        return 0
    p = UsageParser(prog=PROG, add_help=False)
    p.add_argument("--config"); p.add_argument("--broker"); p.add_argument("--user")
    p.add_argument("--password"); p.add_argument("--border-eui", dest="border_eui")
    p.add_argument("--prefix"); p.add_argument("--timeout", type=int, default=25)
    p.add_argument("--local", action="store_true",
                   help="talk to gateway-mesh over ZMQ instead of MQTT (run on the Border; "
                        "works with any LNS egress, needs no broker)")
    p.add_argument("--from-gateway", action="store_true",
                   help="read broker/creds/prefix from /run/relay/mqtt-config.toml (run on the Border)")
    p.add_argument("--catalog", help="path to mesh-commands.json (default: bundled next to this script)")
    sub = p.add_subparsers(dest="cmd", required=True)
    pr = sub.add_parser("reboot", help="reboot a relay (named command from the catalog)")
    pr.add_argument("relay_id")
    pp = sub.add_parser("ping", help="connectivity check: is the relay reachable over the mesh?")
    pp.add_argument("relay_id")
    ph = sub.add_parser("set-hop-count", help="set the relay's mesh max hop count (1-8), persisted")
    ph.add_argument("relay_id"); ph.add_argument("hops", type=int)
    po = sub.add_parser("open-wifi", help="open the relay's WiFi window for N minutes (default 30)")
    po.add_argument("relay_id"); po.add_argument("minutes", type=int, nargs="?", default=None)
    pc = sub.add_parser("close-wifi", help="force the relay's WiFi off now")
    pc.add_argument("relay_id")
    pgf = sub.add_parser("gps-fix", help="acquire a GPS fix and persist the relay location (default 70 min, max 90)")
    pgf.add_argument("relay_id"); pgf.add_argument("minutes", type=int, nargs="?", default=None)
    pgs = sub.add_parser("gps-status", help="report the relay's GPS acquisition status + persisted location")
    pgs.add_argument("relay_id")
    prun = sub.add_parser("run", help="send a named command from the catalog (e.g. status, power, version)")
    prun.add_argument("name"); prun.add_argument("relay_id"); prun.add_argument("payload_hex", nargs="?", default="")
    ps = sub.add_parser("send", help="send an arbitrary proprietary command by number")
    ps.add_argument("relay_id"); ps.add_argument("command_type", type=int)
    ps.add_argument("payload_hex", nargs="?", default="")
    sub.add_parser("list-commands", help="list the command types in the local catalog")
    pd = sub.add_parser("discover", help="ask a relay which command types it has configured (mesh discovery)")
    pd.add_argument("relay_id")
    prl = sub.add_parser("relays", help="list relay_ids the border is hearing (passive mesh discovery)")
    prl.add_argument("--for", dest="for_seconds", type=int, default=330, metavar="SECONDS",
                     help="seconds to listen (default 330 = one 5m heartbeat interval + margin)")
    args = p.parse_args()

    catalog = load_catalog(args.catalog)

    if args.cmd == "list-commands":
        print("%-4s %-12s %s" % ("TYPE", "NAME", "DESCRIPTION"))
        for c in sorted(catalog, key=lambda c: c["type"]):
            print("%-4d %-12s %s" % (c["type"], c["name"], c.get("description", "")))
        return 0

    if args.local:
        # No broker, no topics, no credentials. The only thing still needed is
        # the border's own EUI, which gateway-mesh can be asked for directly.
        cfg = {"broker": None, "user": None, "pass": None, "prefix": None,
               "border_eui": (args.border_eui or "").lower() or None}
        if not cfg["border_eui"]:
            cfg["border_eui"] = local_border_eui()
            if not cfg["border_eui"]:
                sys.exit("error: could not read the border gateway id from gateway-mesh")
    else:
        cfg = load_config(args)
        missing = [k for k in ("broker", "border_eui", "prefix") if not cfg[k]]
        if missing:
            sys.exit("error: missing config: %s\n"
                     "  --local          on the Border: needs nothing else\n"
                     "  --from-gateway   on the Border: reads broker, credentials and EUI\n"
                     "                   from /run/relay (the mesh stack must be running)\n"
                     "  otherwise        set them in mesh-cmd.conf, the environment, or flags"
                     % ", ".join(missing))

    if args.cmd == "relays":
        if args.local:
            seen = local_listen_for_relays(args.for_seconds)
        else:
            evt_topic = "%s/gateway/%s/event/mesh" % (cfg["prefix"], cfg["border_eui"])
            seen = listen_for_relays(cfg["broker"], cfg["user"], cfg["pass"], evt_topic, args.for_seconds)
        now = time.time()
        if not seen:
            print("\nno relays heard in %ds. Relays announce on their heartbeat interval --"
                  " try a longer --for, or confirm the border is up." % args.for_seconds)
            return 2
        print("\nheard %d relay(s):" % len(seen))
        print("%-10s %-11s %-5s %s" % ("RELAY_ID", "LAST_SEEN", "MSGS", "VIA"))
        for rid, rec in sorted(seen.items(), key=lambda kv: -kv[1]["last"]):
            print("%-10s %-11s %-5d %s" % (rid, "%ds ago" % int(now - rec["last"]),
                                           rec["count"], ",".join(sorted(rec["via"])) or "-"))
        print("\ntip: target one with e.g.  mesh-cmd --config <conf> discover <relay_id>")
        return 0

    def named_type(name):
        match = [c for c in catalog if c["name"] == name]
        if not match:
            sys.exit("error: '%s' is not in the command catalog (%s)"
                     % (name, args.catalog or "bundled mesh-commands.json"))
        return match[0]["type"]

    if args.cmd == "reboot":
        ctype, payload = named_type("reboot"), b""
    elif args.cmd == "ping":
        ctype, payload = named_type("ping"), b""
    elif args.cmd == "discover":
        ctype, payload = named_type("list-commands"), b""
    elif args.cmd == "set-hop-count":
        if not (1 <= args.hops <= 8):
            sys.exit("error: hops must be 1-8 (mesh hop_count is 3 bits: 1..8)")
        ctype, payload = named_type("set-hop-count"), str(args.hops).encode()
    elif args.cmd == "open-wifi":
        if args.minutes is not None and not (1 <= args.minutes <= 720):
            sys.exit("error: minutes must be 1-720 (or omit for the relay default of 30)")
        payload = str(args.minutes).encode() if args.minutes is not None else b""
        ctype = named_type("open-wifi")
    elif args.cmd == "close-wifi":
        ctype, payload = named_type("close-wifi"), b""
    elif args.cmd == "gps-fix":
        if args.minutes is not None and not (1 <= args.minutes <= 90):
            sys.exit("error: minutes must be 1-90 (or omit for the relay default of 70)")
        payload = str(args.minutes).encode() if args.minutes is not None else b""
        ctype = named_type("gps-fix")
    elif args.cmd == "gps-status":
        ctype, payload = named_type("gps-status"), b""
    elif args.cmd == "run":
        ctype = named_type(args.name)
        payload = bytes.fromhex(args.payload_hex) if args.payload_hex else b""
    else:  # send
        ctype = args.command_type
        if not (128 <= ctype <= 255):
            sys.exit("error: command_type must be 128-255 (proprietary range)")
        payload = bytes.fromhex(args.payload_hex) if args.payload_hex else b""

    relay_id = args.relay_id.lower()
    pl = build_mesh_command(cfg["border_eui"], relay_id, ctype, payload)
    print("border_eui=%s relay_id=%s command_type=%d payload=%s"
          % (cfg["border_eui"], relay_id, ctype, payload.hex() or "(empty)"))

    show = args.cmd != "discover"   # discover formats its own output below
    if args.local:
        rc, events = local_send_and_wait(pl, args.timeout, show=show, expect_rid=relay_id)
    else:
        cmd_topic = "%s/gateway/%s/command/mesh" % (cfg["prefix"], cfg["border_eui"])
        evt_topic = "%s/gateway/%s/event/mesh" % (cfg["prefix"], cfg["border_eui"])
        rc, events = publish_and_wait(cfg["broker"], cfg["user"], cfg["pass"],
                                      cmd_topic, evt_topic, pl, args.timeout, show=show,
                                      expect_rid=relay_id)

    if args.cmd == "discover":
        resp = next((pl for et, pl in events if et == ctype), None)
        if resp is None:
            print("\n=> no discovery response (relay unreachable, or it doesn't support command %d)" % ctype)
            return 2
        by_type = {c["type"]: c for c in catalog}
        types = [int(x) for x in resp.decode(errors="replace").replace("\n", "").split(",") if x.strip().isdigit()]
        print("\nrelay %s supports %d command(s):" % (relay_id, len(types)))
        print("%-4s %-14s %s" % ("TYPE", "NAME", "DESCRIPTION"))
        for t in sorted(types):
            c = by_type.get(t)
            print("%-4d %-14s %s" % (t, c["name"] if c else "(unknown)",
                                     c.get("description", "") if c else "not in local catalog"))
        return 0
    return rc

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError) as e:
        sys.exit("error: %s" % e)
